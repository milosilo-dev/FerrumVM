# /etc/inittab

# Mount /proc, /sys and /dev, then bring up the network
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100

# Put a getty on VT1 so the framebuffer console (visible through the virtio-gpu
# display) shows a login prompt instead of sitting blank.
tty1::respawn:/sbin/getty -L 38400 tty1

# Stuff to do for the 3-finger salute
::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/sbin/openrc shutdown

